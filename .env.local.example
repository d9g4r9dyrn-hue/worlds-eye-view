# Optional. Adds Windy's global webcam catalogue to the map.
#
# Everything else needs no key at all — the 511 traveler-information
# feeds, Caltrans, DriveBC, Fintraffic, NZTA, Transport for London, LTA
# Singapore and the Alaska Volcano Observatory are all open. Without a
# Windy key the map still works, but coverage is North America, Finland,
# London, New Zealand and Singapore only, and the observatory / zoo /
# landmark cameras stay missing since almost all of those are stream-only
# outside Windy.
#
# Free key: https://api.windy.com/webcams
# WINDY_API_KEY=


# ---- Accounts (all optional) -------------------------------------------
# Sign-in exists for one reason: saving more than one camera wall. With
# none of the below set, the app runs exactly as before — the map is fully
# usable, the sign-in button is hidden, and walls live in localStorage.
#
# All three are required together. Missing any one leaves accounts off.

# Postgres for users, sessions and saved dashboards. The camera catalogue
# is NOT stored here — it stays in memory and rebuilds on boot, so the app
# still needs no volume.
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Random secret signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_SECRET=

# Google OAuth client (see DEPLOY.md for the exact console steps).
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Public URL, used to build the OAuth callback. Railway sets the host
# itself, so AUTH_TRUST_HOST=true is enough there.
# AUTH_URL=https://cams.corticorp.com
# AUTH_TRUST_HOST=true
